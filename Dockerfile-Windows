# │ 🚀 RUNNING CONTAINERS                                                  │
# └───────────────────────────────────────────────────────────────────────┘
#
# Interactive session:
#   docker run -it --rm fnxnt:windows-amd64
#
# Debug another container's network:
#   docker run -it --rm --net container:<container_name> `
#     fnxnt:windows-amd64
#
# With Docker named pipe for ctop:
#   docker run -it --rm `
#     -v \\.\pipe\docker_engine:\\.\pipe\docker_engine `
